target_os = "android"
# arm64-v8a 64-bit only architecture target (no 32-bit, no universal)
target_cpu = "arm64"
enable_android_secondary_abi = false

# Android 10 (API level 29) compatibility
default_min_sdk_version = 29

android_channel = "stable"
android_default_version_name = "153.0.8010.52"
android_default_version_code = "801005200"

ext_version_enabled = true
ext_version_increment = "0"

is_component_build = false
is_debug = false
is_official_build = false
chrome_pgo_phase = 0

# Primary Size & Compilation Optimizations:
optimize_for_size = true
use_icf = true

# Stripping & Build Speed Optimizations
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
strip_debug_info = false
enable_resource_allowlist_generation = false
use_thin_lto = false
is_cfi = false
use_cfi_cast = false

cc_wrapper = "ccache"

# Disable unused sub-systems for speed & size (Ported & Expanded from Titanium/Palladium)
enable_pdf = false
enable_printing = false
enable_speech_service = false
enable_spellcheck = false
enable_hunspell = false
enable_feed_v2 = false
enable_mdns = false
enable_service_discovery = false
enable_gwp_asan = false
enable_lens = false
enable_compose = false
enable_hangout_services_extension = false

enable_vr = false
enable_arcore = false
enable_openxr = false
enable_cardboard = false
enable_remoting = false
enable_reporting = false

# Speed optimizations from Titanium Browser
build_contextual_search = false
dcheck_always_on = false
enable_iterator_debugging = false
rtc_build_examples = false
use_errorprone_java_compiler = false
use_rtti = false
include_both_v8_snapshots = false
include_both_v8_snapshots_android_secondary_abi = false

# Media Codecs and Platform Features (Ported from Titanium & Palladium)
enable_av1_decoder = true
enable_dav1d_decoder = true
enable_platform_ac3_eac3_audio = true
enable_platform_hevc = true
enable_hevc_parser_and_hw_decoder = true
enable_platform_dolby_vision = true
enable_platform_encrypted_dolby_vision = true
enable_platform_iamf_audio = true
enable_platform_mpeg_h_audio = true

disable_fieldtrial_testing_config = true
dfmify_dev_ui = false

# Password Manager local database
use_login_database_as_backend = true

# Codecs
ffmpeg_branding = "Chrome"
proprietary_codecs = true

trichrome_certdigest = "da378d6a117dca6ecaf39e653efb2d6b686894c4de28ca0792b76565d85a9634"

# Stock Vanadium Package Names
chrome_public_manifest_package = "app.vanadium.browser"
system_webview_package_name = "app.vanadium.webview"
trichrome_library_package = "app.vanadium.trichromelibrary"

config_apk_package = "app.vanadium.config"
config_apk_certdigest = "da378d6a117dca6ecaf39e653efb2d6b686894c4de28ca0792b76565d85a9634"
config_apk_version_name = "209"
config_apk_version_code = "209"
config_apk_is_debug = false

android_static_analysis = "off"

# Direct ninja execution with ccache for 100% object caching across workflow runs
use_siso = false

# DrumBrake JS interpreter mode
v8_enable_drumbrake = true
v8_drumbrake_bounds_checks = true
